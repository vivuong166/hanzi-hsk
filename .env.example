# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-value
CLIENT_ORIGIN=http://127.0.0.1:4173
# Set require for hosted PostgreSQL. Disable is only permitted for a trusted local database.
DATABASE_SSL_MODE=require
# Set to 1 only when the deployed server is behind one trusted reverse proxy.
TRUST_PROXY=0
PORT=3001
# Comma-separated emails of existing accounts promoted to admin when the server starts.
ADMIN_EMAILS=admin@example.com
